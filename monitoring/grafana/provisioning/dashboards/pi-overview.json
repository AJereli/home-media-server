          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",instance=\"raspberrypi\",mountpoint=\"/mnt/media\"} / node_filesystem_size_bytes{job=\"node-exporter\",instance=\"raspberrypi\",mountpoint=\"/mnt/media\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
